@PACKAGE_INIT@

# maxima_cpp drives a Maxima child process over pipes, so it pulls in no
# computer algebra library. It does need Boost's headers: mx::Integer is backed
# by Boost.Multiprecision's cpp_int, which appears in <mx/integer.hpp> and
# therefore in every consumer that includes <mx/expr.hpp>. On Unix it also needs
# a thread library, for the POSIX transport's teardown wait.
include(CMakeFindDependencyMacro)

# Boost is fetched by CPM at build time and installed into this same prefix,
# because mx::Integer holds a cpp_int by value and so <mx/integer.hpp> needs
# those headers. Look here first, so a consumer gets the Boost this library was
# actually compiled against rather than whichever one happens to be on the path.
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
find_dependency(Boost COMPONENTS multiprecision)

if (NOT WIN32)
    find_dependency(Threads)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/maxima_cppTargets.cmake")

check_required_components(maxima_cpp)
