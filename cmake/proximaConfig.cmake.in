@PACKAGE_INIT@

# Proxima drives a Maxima child process over pipes, so it pulls in no
# computer algebra library, and no public header includes Boost: the
# Boost.Multiprecision behind proxima::Integer is private to the library. On
# Unix it needs a thread library, for the POSIX transport's teardown wait.
include(CMakeFindDependencyMacro)

# Boost is fetched by CPM at build time and installed into this same prefix.
# Proxima is a static library, so the Boost.Process it was built against is
# linked into the consumer's executable. Look here first, so a consumer gets
# that Boost rather than whichever one happens to be on the path.
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
find_dependency(Boost COMPONENTS process)

if (NOT WIN32)
    find_dependency(Threads)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/proximaTargets.cmake")

check_required_components(proxima)
