# The style of this code: LLVM, with 4-space indentation, breaks before binary
# operators (= included), and lines kept to 85 columns.
#
# Applied to the whole tree once, with clang-format 23.1.0 (TODO §9.5), and
# checked by CI with that same version, which `pip install clang-format==23.1.0`
# provides anywhere; another version can place a line break differently. Format
# what you change with `git clang-format`, or everything with
#
#     git ls-files '*.cpp' '*.hpp' | xargs clang-format -i
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 85
BreakBeforeBinaryOperators: All
AlignOperands: Align
IndentCaseLabels: false
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
IndentRequiresClause: true
RequiresClausePosition: OwnLine
# doctest's TEST_SUITE opens a block the way a namespace does, and is
# indented like one: not at all.
NamespaceMacros: [TEST_SUITE]
